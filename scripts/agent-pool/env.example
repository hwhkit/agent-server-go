# IR Agent Pool —— 环境变量模板（脱敏版）
# 真实密钥在机上：各池工作目录的 pool-env（systemd EnvironmentFile 同源），
# 本目录只有模板；真实凭据永不入库。
#
# 智能体连接点（方案 B）：key = 智能体签名密钥（主密钥）或其集群派生子密钥
# （用 derive-key.sh 生成；子密钥可按集群吊销，主密钥通用）。

# IR 平台地址（生产走 HTTPS；本机开发 http://127.0.0.1:8080）
IR_SERVER="http://127.0.0.1:8080"

# 该池服务的智能体（slug + 密钥即连接点；一个池认领一个智能体的队列）
AGENT_SLUG="my-agent"
AGENT_KEY="<REDACTED>"
# 可选：集群标识（配了走派生子密钥校验，可按集群吊销；建议 hostname）
CLUSTER="alpha"

# 池工作目录（runs/undelivered/pool.log 所在；与 DeAlan 版目录结构兼容）
POOL_DIR="$HOME/ir-pool"

# 原 dispatcher 版 run-task.sh 路径（sec03 管线入口；启动时自动打补丁复用）
RUN_TASK_ORIG="$HOME/agent-dispatcher-workers/cc-pool/run-task.sh"

# 并发槽位数（pi=5 / cc=10，与原池一致）
MAX_SLOTS="10"
# 任务级本地超时兜底（秒；服务端 executionDeadline 才是权威墙钟）
TASK_TIMEOUT_SECS="600"

# 以下为原管线依赖（run-task.sh 照常读取；凭据在机上 pool-env）
# POOL_CHAIN="deepseek glm qwen"
# DEEPSEEK_API_KEY="<REDACTED>"
# ZAI_API_KEY="<REDACTED>"
# QWEN_TOKEN_PLAN_API_KEY="<REDACTED>"
