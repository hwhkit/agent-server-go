# Intelligent Router 协议桥。
#
# 配置加载层级（与 Rust 版一致）:
#   config/default.toml 的 [ir] 段
#   -> config/{IR_ENV}.toml 的 [ir] 段（IR_ENV 默认 dev；设为 default 则跳过这一层）
#   -> 下列 IR__* 环境变量（空字符串视为未设置，不覆盖文件层）
#
# 注意前缀是双下划线 IR__，与配置段名 [ir] 分隔。
#
# 本模板故意不提供任何可用凭据。复制为 .env.dev 后必须填入真实随机值；
# 服务也会拒绝已知模板占位符，避免误用公开凭据启动。
IR_ENV=dev
IR__PUSH_ENABLED=true
IR__PUSH_PATH=/ir/push
IR__SIGNING_SECRET=
IR__SIGNATURE_ENCODING=hex
IR__PUSH_MODE=sync
IR__PULL_ENABLED=false
IR__QUEUE_URL=https://queue.example.com
IR__BIND_TOKEN=
IR__WORKER_ID=worker-1
IR__CLAIM_TIMEOUT_SECS=60
IR__HEARTBEAT_INTERVAL_SECS=60
IR__RENEW_INTERVAL_SECS=30
IR__TASK_TIMEOUT_SECS=600
# Push 形态心跳地址（平台绑定信息下发）；留空则 Push 心跳禁用。
IR__HEARTBEAT_URL=
# 可选回调令牌（mpk_*）；非空时附加到 callback URL 的 ?token=。
# 新平台（2026-08-17 起）令牌可选，可留空。
IR__CALLBACK_TOKEN=
# 使用 legacy token 时必填，且只能是 scheme + host（例如 https://api.example.com）。
IR__CALLBACK_TOKEN_ORIGIN=
# 信封 usage 自 2026-09-16 起总是回传（RULE-BND-001）：执行器有计量用真实值，没有则兜底最小合规值（平台要求 totalTokens > 0）。
# 本开关只对「受信 Investor Workflow Host」生效：开启后拿不到供应商 FINAL usage 的结果直接判失败
# （同步 502 / 异步抑制 callback），不再走零值兜底。
IR__TRUSTED_USAGE_REPORTING_ENABLED=false
# agentCode 未命中 Registry 时使用的默认动态 Agent slug；留空表示必须精确匹配。
IR__DEFAULT_AGENT_SLUG=

# 单体多 Agent 管理平台
PLATFORM__ENABLED=true
PLATFORM__PUBLIC_BASE_URL=http://127.0.0.1:8080
PLATFORM__ALLOW_LEGACY_BODY_SIGNATURE=false
PLATFORM__MAX_REQUEST_BODY_BYTES=2097152
PLATFORM__GLOBAL_MAX_CONCURRENCY=16
# PostgreSQL 连接串（平台存储与 Push 幂等共用同一个库）。
DATABASE_URL=postgres://ir:ir@127.0.0.1:5432/ir_agent

ADMIN__USERNAME=your-account@example.com
# 二者其一：12–512 字节明文密码（启动时用 Argon2id 现算哈希），或直接给 Argon2id PHC 串。
ADMIN__PASSWORD=
# ADMIN__PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...
# 至少 32 字节随机值；同时作为 Agent Signing Secret 的 AES-256-GCM 主密钥，
# 因此上线后不可随意更换（更换会导致已存密钥无法解密）。
# 可用 `openssl rand -base64 48` 生成；不要复用管理员密码或 IR 签名密钥。
ADMIN__SESSION_SECRET=
ADMIN__SESSION_TTL_SECS=259200
ADMIN__SECURE_COOKIES=false
# 仅在服务直连这些反向代理时解析 X-Forwarded-For；逗号分隔 CIDR。
# 代理必须清除客户端自带的 X-Forwarded-For 并重新生成/追加可信链。
ADMIN__TRUSTED_PROXY_CIDRS=

# Claude Code 本机执行器
CLAUDE__ENABLED=false
CLAUDE__BINARY=claude
CLAUDE__WORKSPACE_ROOT=.
CLAUDE__DEFAULT_MODEL=dsk_4f
CLAUDE__MAX_OUTPUT_BYTES=1048576
CLAUDE__ALLOWED_ENV=HOME,PATH,USER,TMPDIR,XDG_CONFIG_HOME,ANTHROPIC_API_KEY,CLAUDE_CODE_USE_BEDROCK,CLAUDE_CODE_USE_VERTEX,AWS_PROFILE,AWS_REGION,AWS_DEFAULT_REGION

# Agent 网关调用（litellm）。protocol 支持 anthropic 与 openai。
AGENT_GATEWAY__BASE_URL=
AGENT_GATEWAY__API_KEY=
AGENT_GATEWAY__MODEL=dsk_4f
AGENT_GATEWAY__PROTOCOL=anthropic
AGENT_GATEWAY__MAX_TOKENS=16384
AGENT_GATEWAY__MAX_ATTEMPTS=3

# 本机 Agent CLI
LOCAL_AGENT__CODEX_BINARY=codex
LOCAL_AGENT__PI_BINARY=/usr/local/bin/pi
LOCAL_AGENT__REASONIX_BINARY=/usr/local/bin/reasonix
LOCAL_AGENT__DEFAULT_MODEL=litellm/dsk_4f
# 可选：Pi 基本面/技术分析岗位的只读金融与行情数据扩展。
LOCAL_AGENT__FINANCE_EXTENSION_PATH=
# 逗号分隔的 SKILL.md 绝对路径。
LOCAL_AGENT__STRATEGY_SKILL_PATHS=
LOCAL_AGENT__ANALYSIS_SKILL_PATHS=
LOCAL_AGENT__WORKFLOW_SKILL_PATHS=

# 新增本机 Harness
LOCAL_AGENT__DEEPSEEK_HARNESS_BINARY=dsh
LOCAL_AGENT__OPENCODE_BINARY=opencode
LOCAL_AGENT__QWEN_CODE_BINARY=qwen
LOCAL_AGENT__GEMINI_CLI_BINARY=gemini
LOCAL_AGENT__OPENHANDS_BINARY=openhands

# 可选托管智能体（密钥也可在智能体中心页面配置）
# OPENAI_AGENTS__ENABLED=true
# OPENAI_AGENTS__API_KEY=
# CLAUDE_MANAGED__ENABLED=true
# CLAUDE_MANAGED__API_KEY=
# CLAUDE_MANAGED__AGENT_ID=agent_xxx
# CLAUDE_MANAGED__ENVIRONMENT_ID=env_xxx
