-- # 生产环境变量模板
-- #
-- # 复制到 /etc/ir/env.conf（systemd EnvironmentFile）或 Docker env_file。
-- # 不要提交到仓库——这是生产凭据的模板。

# --- 平台核心 ---
DATABASE_URL=postgres://ir:CHANGE_ME@db-host:5432/ir?sslmode=require
PLATFORM__ENABLED=true
PLATFORM__PUBLIC_BASE_URL=https://ir.example.com
PLATFORM__GLOBAL_MAX_CONCURRENCY=256
PLATFORM__DB_MAX_CONNS=32
PLATFORM__RATE_LIMIT_IP_PER_MINUTE=60
PLATFORM__RATE_LIMIT_USER_PER_MINUTE=30
# 数据保留（天）：0=禁用（生产建议 90）
PLATFORM__RETENTION_DAYS=90

# --- 管理员 ---
ADMIN__USERNAME=admin@ir.example.com
ADMIN__PASSWORD=CHANGE_ME_USE_RANDOM
# openssl rand -base64 48
ADMIN__SESSION_SECRET=CHANGE_ME_MIN_32_BYTES_RANDOM
ADMIN__SECURE_COOKIES=true
ADMIN__SESSION_TTL_SECS=86400

# --- MOTA / IR 接入 ---
IR__PUSH_ENABLED=true
IR__PUSH_MODE=async
IR__PUSH_PATH=/ir/push
IR__SIGNING_SECRET=CHANGE_ME_FROM_MOTA
IR__SIGNATURE_ENCODING=hex

# --- Agent API ---
AGENT_API__ENABLED=true
AGENT_API__LEASE_SECONDS=90
AGENT_API__MAX_ATTEMPTS=3
AGENT_API__CLAIM_MAX_WAIT_SECONDS=30
AGENT_API__MAX_OUTSTANDING_LEASES=256
AGENT_API__QUEUE_TTL_SECONDS=3600
